{
  "name": "claude-replay",
  "version": "0.8.0",
  "description": "Convert Claude Code, Copilot CLI, Cursor, Codex CLI, Gemini CLI, and OpenCode transcripts into self-contained, embeddable HTML replays",
  "type": "module",
  "bin": {
    "claude-replay": "dist/bin/claude-replay.js"
  },
  "files": [
    "dist/"
  ],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "tsx scripts/build-editor-app.ts && tsx scripts/build-template.ts && tsc -p tsconfig.json && tsx scripts/copy-dist-assets.ts",
    "build:website": "bun run build && tsx scripts/build-website.ts",
    "dev": "tsx watch --clear-screen=false scripts/dev-editor.ts",
    "dev:cli": "node --import tsx bin/claude-replay.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "doctor": "bun run format && bun run lint",
    "test": "node --import tsx --test test/test-*.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "replay",
    "transcript",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/es617/claude-replay"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
